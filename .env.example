# docker-compose environment file for docker-transmission
# Copy this to .env and customize values as needed.
# SECURITY: .env files are NOT git-ignored by default. Use `chmod 600 .env`
# For production, use Docker secrets instead of plaintext credentials.

# ======================================================================
# IMAGE SETTINGS
# ======================================================================
# Docker image to use (replace 'yourdockerhubuser' with your Docker Hub username)
IMAGE=yourdockerhubuser/docker-transmission:latest

# ======================================================================
# CONTAINER USER SETTINGS
# ======================================================================
# User ID - the UID that runs the Transmission process inside the container
# Should match the UID of the user who owns the download/config directories on the host
PUID=1000

# Group ID - the GID for the Transmission process inside the container
# Should match the GID of the group that owns the download/config directories on the host
PGID=1000

# Timezone - set the container's timezone (e.g., America/Toronto, Etc/UTC, Europe/London)
TZ=Etc/UTC

# ======================================================================
# TRANSMISSION WEB UI SETTINGS
# ======================================================================
# Custom web UI path (optional - leave empty to use default)
TRANSMISSION_WEB_HOME=

# Web UI username (leave empty for no authentication)
USER=

# Web UI password (leave empty for no authentication)
PASS=

# IP address whitelist for RPC access (comma-separated, e.g., "127.0.0.1,192.168.1.100")
WHITELIST=

# Hostname whitelist for web access (comma-separated, e.g., "localhost,example.com")
HOST_WHITELIST=

# ======================================================================
# TRANSMISSION TORRENT SETTINGS
# ======================================================================
# Peer port for torrent traffic (port that remote peers connect to)
PEERPORT=

# Script to execute when a torrent completes downloading
# Default symlink script: /app/symlink-videos.sh
DONESCRIPT=/app/symlink-videos.sh

# Directory inside container where completed torrents are symlinked (used by DONESCRIPT)
TARGET_DIR=./video-links

# Enable blocklist filtering for peer connections (true or false)
BLOCKLIST_ENABLED=false

# URL to blocklist file (e.g., http://www.example.com/blocklist)
# Leave empty to disable. Common blocklist sources: https://github.com/Transmisson/blocklists
BLOCKLIST_URL=

# ======================================================================
# PORT MAPPING
# ======================================================================
# Host port for Transmission web UI (maps to container's 9091)
WEB_PORT=9091

# Host port for torrent peer traffic (maps to container's PEERPORT)
TORRENT_PORT=51413

# ======================================================================
# VOLUME MOUNT PATHS
# ======================================================================
# Host directory for Transmission configuration and database
# Must be readable/writable by UID:GID specified above (PUID:PGID)
CONFIG_DIR=./config

# Host directory where torrents are downloaded
# Must be readable/writable by UID:GID specified above (PUID:PGID)
DOWNLOADS_DIR=./downloads

# Host directory for watch folder (place .torrent files here to auto-import)
# Must be readable/writable by UID:GID specified above (PUID:PGID)
WATCH_DIR=./watch

# ======================================================================
# DOCKER NETWORKING
# ======================================================================
# Docker network name for container communication
# Create network before running: docker network create transmission-network
NETWORK_NAME=transmission-network
